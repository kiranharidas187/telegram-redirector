# Copy this file to .env and fill in your own values.
# Get API_ID / API_HASH from https://my.telegram.org/apps

API_ID=
API_HASH=

# Everything below (CHANNEL, voices, tuning) is only read by the headless
# CLI script (telegram_tts_reader.py). If you're using the web portal
# instead (`python app.py`), you don't need any of it — channels, voices,
# speech rate and volume are all set from the browser and stored in
# config.json.

# Public channel: just the username, e.g. "durov" for t.me/durov
# Private channel/group: numeric ID (run list_my_channels.py to find it)
# Either form works as a plain value, no quotes needed — the script detects
# and converts numeric IDs to int automatically.
# To listen to multiple channels at once, separate them with commas:
#   CHANNEL=durov,-100123456789
CHANNEL=

# Optional: only used when CHANNEL lists more than one channel. Each channel
# automatically gets a different TTS voice so you can tell them apart by
# ear (channel name is also announced automatically in that case). To pick
# specific voices yourself instead, list one per channel here, in the same
# order as CHANNEL, comma-separated. Leave an entry blank to still
# auto-assign that one, e.g. CHANNEL_VOICES=Samantha,,Daniel
# (voice names are OS-specific — pyttsx3 docs explain how to list yours)
CHANNEL_VOICES=

# Optional tuning (defaults shown are used if left unset)
SPEECH_RATE=175
ANNOUNCE_SENDER=false
